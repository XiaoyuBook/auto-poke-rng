# Preserve the upstream bytes recorded in runtime/python/vendor-manifest.json.
runtime/python/easycon/native/*.py -text
# Preserve the canonical commit bytes hashed in the PokeFinder manifest.
third_party/PokeFinder/** -text
# Keep the original Project_Xs files byte-identical to their pinned revision.
third_party/Project_Xs/** -text
third_party/bdsp-automation-reference/** -text
# Keep the bundled reverse script byte-identical to its published script package.
resources/automation/bdsp-starter/reverse.ecs -text
runtime/python/auto_bdsp_rng/**/*.py -text
src/generated/bdsp-data.json text eol=lf
runtime/generated/bdsp_data.hpp text eol=lf
# Keep the pinned FRLG generator and extension hashes stable on Windows.
runtime/python/frlg_planner/assets/easycon118_extensions/** -text
runtime/python/frlg_planner/automation/easycon118.py -text
runtime/python/frlg_planner/automation/precalibration.py -text
runtime/python/frlg_planner/automation/calibration_trust_gates.py -text
runtime/python/frlg_planner/automation/seed_common_regions.py -text
runtime/python/frlg_planner/automation/starter_calibration.py -text
runtime/python/frlg_planner/device_label_overrides.py -text
# Unified diff context lines contain a required leading space on blank lines.
tools/frlg-runtime-patches/*.patch text eol=lf whitespace=-blank-at-eol
